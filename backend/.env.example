# Copy this file to ".env" (gitignored) and fill with real values.
# Never commit real secrets: APP_SECRET, ADMIN_PASSWORD_HASH, etc. live in the
# gitignored ".env" / ".env.local" only.

###> symfony/framework-bundle ###
APP_ENV=dev
# Generate one, e.g.: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=dev_CHANGE_ME
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> human-images-prompts auth ###
ADMIN_EMAIL=admin@example.com
# bcrypt/argon2 hash of your monousuario admin password ("password" by default):
#   php -r "echo password_hash('password', PASSWORD_DEFAULT);"
# Leave empty to disable login until you set a real hash.
ADMIN_PASSWORD_HASH=
###< human-images-prompts auth ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite (default). For shared hosting, switch to MySQL:
# DATABASE_URL="mysql://USER:PASS@HOST:3306/DBNAME"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###
